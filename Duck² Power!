<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>魔法代碼產生器</title>
    <style>
        body { font-family: Arial, sans-serif; text-align: center; padding-top: 50px; background-color: #f0f2f5; color: #333; }
        .container { background: white; padding: 30px; border-radius: 10px; display: inline-block; box-shadow: 0px 0px 10px rgba(0,0,0,0.1); max-width: 90%; }
        input { padding: 12px; margin: 10px 0; width: 80%; border: 1px solid #ccc; border-radius: 5px; font-size: 16px; }
        button { padding: 12px 24px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px; margin-top: 15px; width: 85%; }
        button:hover { background: #0056b3; }
        .result-box { display: none; margin-top: 20px; padding: 15px; background: #e9ecef; border-radius: 5px; text-align: left; word-break: break-all; }
    </style>
</head>
<body>
    <div class="container">
        <h2>✨ 開啟你的冒險 ✨</h2>
        <p>輸入你的年齡：<br><input type="number" id="age" placeholder="例如: 20"></p>
        <p>輸入你的生日月份：<br><input type="number" id="bir" placeholder="例如: 5"></p>
        <button onclick="startAdventure()">產生魔法代碼</button>

        <div id="result" class="result-box"></div>
        <button id="goBtn" style="display:none; background:#28a745;" onclick="redirectToRickRoll()">開啟你的冒險網站</button>
    </div>

    <script>
        function startAdventure() {
            var age = document.getElementById('age').value;
            var bir = document.getElementById('bir').value;
            if(!age || !bir) { alert('請填寫完整資料！'); return; }
            
            var code = age * bir;
            
            var resultDiv = document.getElementById('result');
            resultDiv.innerHTML = `
                <p>恭喜你獲得你的魔法代碼：${code}</p>
                <p>將代碼貼上在以下連結的網站，開啟你的冒險：<br><span style="color:#007bff;">https://share.google</span></p>
            `;
            resultDiv.style.display = 'block';
            document.getElementById('goBtn').style.display = 'inline-block';
        }

        function redirectToRickRoll() {
            window.location.href = "https://youtube.com"; 
        }
    </script>
</body>
</html>
